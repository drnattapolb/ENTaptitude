rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all unspecified routes
    match /{document=**} {
      allow read, write: if false;
    }

    // Healthcheck / test connection route
    match /test/connection {
      allow read: if true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /candidates/{candidateId} {
      // Allow reading candidate list and reports for interview dashboard
      allow read: if true;

      // Allow applicant to submit their assessment
      allow create: if isValidId(candidateId)
        && request.resource.data.id == candidateId
        && request.resource.data.candidateName is string
        && request.resource.data.candidateName.size() > 0
        && request.resource.data.candidateName.size() <= 150
        && request.resource.data.submittedAt is string
        && request.resource.data.totalScore is number;

      // Allow committee to update interview notes, status, care plan, and ratings
      allow update: if isValidId(candidateId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.candidateName == resource.data.candidateName
        && request.resource.data.submittedAt == resource.data.submittedAt;

      allow delete: if false;
    }
  }
}
